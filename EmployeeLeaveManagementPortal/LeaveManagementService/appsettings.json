{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ClientName": "LeaveService",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=microservices_leaves_db2;Username=admin;Password=admin123"
  },
  "RabbitMQUserCreatedConsume": {
    "HostName": "192.168.1.5",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "QueueName": "leavebalance.initializing.queue",
    "ExchangeName": "user.events",
    "RoutingKey": "user.created",
    "MessageTtlMilliseconds": 0
  },
  "RabbitMQLeaveStatusPublish": {
    "HostName": "192.168.1.5",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExchangeName": "leave.events",
    "RoutingKey": "leave.statusupdated",
    "MessageTtlMilliseconds": 86400000
  },
  "JwtSettings": {
    "SecretKey": "YoursSuperSecretKeyThatIsAtLeast32CharactersLongForHS256Algorithm",
    "Issuer": "MicrosoftArchitecture",
    "Audience": "MicrosoftArchitecture",
    "ExpirationMinutes": 60
  },
  "Eureka": {
    "Client": {
      "ServiceUrl": "http://localhost:8761/eureka/",
      "ShouldRegisterWithEureka": true,
      "ShouldFetchRegistry": true,
      "LoadBalancer": {
        "Mode": "RoundRobin"
      }
    },
    "Instance": {
      "AppName": "LEAVES-SERVICE",
      "Port": 5002,
      "PreferIpAddress": false,
      "StatusPageUrlPath": "/swagger",
      "HealthCheckUrlPath": "/health"
    }
  },
  "ServiceDiscovery": {
    "UseEureka": false,
    "UserService": {
      "ServiceName": "USER-SERVICE",
      "DirectUrl": "http://localhost:5001"
    }
  },
  "Resilience": {
    "EnablePolly": true,
    "RetryPolicy": {
      "RetryCount": 2,
      "BackoffPower": 2
    },
    "CircuitBreaker": {
      "UseAdvanced": true,
      "Simple": {
        "FailureThreshold": 3,
        "DurationOfBreakSeconds": 30
      },
      "Advanced": {
        "FailureThreshold": 0.75,
        "SamplingDurationSeconds": 60,
        "MinimumThroughput": 3,
        "DurationOfBreakSeconds": 30
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}
