{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "UseEureka": false,
  "Eureka": {
    "Client": {
      "ServiceUrl": "http://localhost:8761/eureka/",
      "ShouldRegisterWithEureka": false,
      "ShouldFetchRegistry": true
    }
  },
  "JwtSettings": {
    "SecretKey": "YoursSuperSecretKeyThatIsAtLeast32CharactersLongForHS256Algorithm",
    "Issuer": "MicrosoftArchitecture",
    "Audience": "MicrosoftArchitecture",
    "ExpirationMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
