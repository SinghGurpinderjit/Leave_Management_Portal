{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ClientName": "UserService",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=microservices_users_db2;Username=admin;Password=admin123"
  },
  "RabbitMQ": {
    "HostName": "192.168.1.5",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExchangeName": "user.events",
    "RoutingKey": "user.created",
    "MessageTtlMilliseconds": 0
  },
  "JwtSettings": {
    "SecretKey": "YoursSuperSecretKeyThatIsAtLeast32CharactersLongForHS256Algorithm",
    "Issuer": "MicrosoftArchitecture",
    "Audience": "MicrosoftArchitecture",
    "ExpirationMinutes": 60
  },
  "Eureka": {
    "Client": {
      "ServiceUrl": "http://localhost:8761/eureka/",
      "ShouldRegisterWithEureka": true,
      "ShouldFetchRegistry": true,
      "LoadBalancer": {
        "Mode": "RoundRobin"
      }
    },
    "Instance": {
      "AppName": "USER-SERVICE",
      "Port": 5001,
      "PreferIpAddress": false,
      "StatusPageUrlPath": "/swagger",
      "HealthCheckUrlPath": "/health"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}
